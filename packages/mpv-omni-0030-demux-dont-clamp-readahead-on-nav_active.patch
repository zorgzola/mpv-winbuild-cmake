diff --git a/demux/demux.c b/demux/demux.c
index 78c6b7e..022df0c 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -2375,8 +2375,13 @@ static bool read_packet(struct demux_internal *in)
     // While interactive disc navigation is active, never read ahead. It would
     // advance the disc VM past what the user is watching. Reads still happen
     // whenever a selected stream demands data.
-    if (in->nav_active)
-        prefetch_more = false;
+    //
+    // Disabled: libbluray reports nav_active for the whole hdmv/BD-J session,
+    // including BD feature-film playback, so this clamp left the demux queue
+    // at 0s cache for the entire film. Reads do not advance the BD VM (jumps
+    // are event-driven), and the legacy Yaozhi build without this clamp
+    // prefetches normally (menu ~0s, feature ~1.9s). nav_pump below keeps
+    // driving the disc event loop.
     prefetch_more |= in->nav_pump;
 
     MP_TRACE(in, "bytes=%zd, read_more=%d prefetch_more=%d, refresh_more=%d\n",
