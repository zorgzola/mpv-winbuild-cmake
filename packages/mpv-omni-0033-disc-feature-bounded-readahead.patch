@@ -3304,6 +3332,22 @@ void demux_set_nav_active(demuxer_t *demuxer, bool active)
     mp_mutex_unlock(&in->lock);
 }
 
+// Tell the cache whether the disc navigation has moved into a long feature
+// title (the movie itself). While false (menu, still, short clip) the demuxer
+// must not read ahead at all.
+void demux_set_nav_feature(demuxer_t *demuxer, bool feature)
+{
+    struct demux_internal *in = demuxer->in;
+    mp_assert(demuxer == in->d_thread);
+
+    mp_mutex_lock(&in->lock);
+    if (in->nav_feature != feature) {
+        in->nav_feature = feature;
+        mp_cond_signal(&in->wakeup);
+    }
+    mp_mutex_unlock(&in->lock);
+}
