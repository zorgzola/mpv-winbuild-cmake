diff --git a/demux/demux_disc.c b/demux/demux_disc.c
index d6f3b2c..7a25490 100644
--- a/demux/demux_disc.c
+++ b/demux/demux_disc.c
@@ -444,6 +445,64 @@ static void sync_streams(struct demuxer *demuxer)
             outer_member->group = grp;
         }
     }
+    // libavformat does not produce a Dolby Vision BL/EL LayeredVideo group for a
+    // Blu-ray MPEG-TS: BL (0x1011) and EL (0x1015) surface as two plain, unrelated
+    // video streams, so the group-mirror above never fires. mpv's DV FEL pairing
+    // (sh_stream_dependent_sibling -> f_enhancement_pair) only engages through a
+    // 2-member stream group, so if the P7 base layer is still ungrouped, bind it
+    // here. The EL is classified by libbluray's authoritative dv_streams[] (the
+    // STN marks DV streams; PiP lives in sec_video_streams, so it is never
+    // mis-paired), not by PID or resolution ordering.
+    if (p->is_bd) {
+        struct stream_dv_info dvinfo = {0};
+        if (stream_control(demuxer->stream, STREAM_CTRL_GET_DV_INFO, &dvinfo) ==
+            STREAM_OK && dvinfo.num_el > 0)
+        {
+            struct sh_stream *bl = NULL, *el = NULL;
+            int non_el_video = 0;
+            for (int i = 0; i < p->num_outer_streams; i++) {
+                struct sh_stream *sh = p->outer_streams[i];
+                if (!sh || sh->type != STREAM_VIDEO)
+                    continue;
+                bool is_el = false;
+                for (int k = 0; k < dvinfo.num_el; k++)
+                    is_el |= sh->demuxer_id == dvinfo.el_pid[k];
+                if (is_el) {
+                    if (!el)
+                        el = sh;
+                } else {
+                    non_el_video++;
+                    bl = sh;
+                }
+            }
+            // Only proceed when there is exactly one EL and exactly one other
+            // video (the BL). Anything else is ambiguous; fail closed.
+            if (el && non_el_video == 1 && bl && bl != el && !bl->group) {
+                MP_VERBOSE(demuxer, "pairing BD DV BL id=0x%x with EL id=0x%x "
+                           "(libbluray dv_streams)\n",
+                           bl->demuxer_id, el->demuxer_id);
+                el->dependent_track = true;
+                // Profile 7 carries the DV metadata (RPU/color) on the EL;
+                // mirror it onto the BL codec so the player recognizes the
+                // base layer as DV immediately, instead of only after
+                // el_pair's inherit_dovi_from_el() sees the first EL frame
+                // (which is what produced the HDR-first, DV-a-few-seconds
+                // startup lag on profile 7 discs).
+                if (bl->codec && el->codec) {
+                    bl->codec->dovi = true;
+                    bl->codec->dv_profile = el->codec->dv_profile ?
+                        el->codec->dv_profile : 7;
+                    bl->codec->dv_level = el->codec->dv_level;
+                    bl->codec->dv_el_present = true;
+                }
+                struct sh_stream_group *grp = talloc_zero(bl, struct sh_stream_group);
+                bl->group = grp;
+                el->group = grp;
+                MP_TARRAY_APPEND(grp, grp->members, grp->num_members, bl);
+                MP_TARRAY_APPEND(grp, grp->members, grp->num_members, el);
+            }
+        }
+    }
 }
 
 static void refresh_disc_metadata(struct demuxer *demuxer);

