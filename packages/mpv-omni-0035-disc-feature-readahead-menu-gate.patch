diff --git a/demux/demux_disc.c b/demux/demux_disc.c
index d6f3b2c..7a25490 100644
--- a/demux/demux_disc.c
+++ b/demux/demux_disc.c
@@ -107,6 +107,7 @@ struct priv {
     uint32_t last_discontinuity_id; // Last source-position-jump id seen from the stream.
     bool nav_active;    // last interactive-nav state pushed to the cache
     bool feature_active; // last long-feature state pushed to the cache
+    bool menu_active;   // last on-screen-menu state pushed to the cache
     uint32_t eof_log_id;    // last logged EOF state, avoids per-read spam
     bool eof_log_still;
 
@@ -908,9 +967,19 @@ static bool d_read_packet(struct demuxer *demuxer, struct demux_packet **out_pkt
             p->nav_active = nav.nav_active;
             demux_set_nav_active(demuxer, nav.nav_active);
         }
-        if (nav.feature_active != p->feature_active) {
+        if (nav.feature_active != p->feature_active ||
+            nav.menu_active != p->menu_active) {
             p->feature_active = nav.feature_active;
-            demux_set_nav_feature(demuxer, nav.feature_active);
+            p->menu_active = nav.menu_active;
+            // Menu-on-screen is the only gate: while a menu/overlay is
+            // visible read-ahead is paused so the cache never races ahead of
+            // the button/BD-J jump the user is on; everywhere else (pre-feature
+            // short clips and the movie alike) bounded feature read-ahead
+            // applies. The duration-based feature flag is deliberately not
+            // used as a master switch anymore -- it zeroed the pre-feature
+            // read-ahead on discs whose menus open after a short bumper
+            // (0s cache vs 16M on the reference player).
+            demux_set_nav_feature(demuxer, !nav.menu_active);
         }
         // DVD holds an EOF at jump boundaries and the player resyncs
         // through the seek path. BD has no in-band boundary, handle it here,
