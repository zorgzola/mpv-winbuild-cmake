--- a/demux/demux_disc.c
+++ b/demux/demux_disc.c
@@ -992,17 +992,28 @@ static bool d_read_packet(struct demuxer *demuxer, struct demux_packet **out_pkt
                 // BD-J title switches can re-arm the drain right after the
                 // player's resync seek acked a previous jump. The player
                 // will not send another seek for the EOF this read would
-                // return: ack the drain here and handle the jump through
