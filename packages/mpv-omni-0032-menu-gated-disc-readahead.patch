diff --git a/demux/demux.c b/demux/demux.c
index 78c6b7e..cad958e 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -210,6 +210,7 @@ struct demux_internal {
     size_t hyst_bytes;          // stop reading till there's hyst_bytes remaining
     bool hyst_active;
     bool nav_active;            // disc navigation (DVD/BD menus) is active
+    bool nav_menu_active;       // a disc menu overlay is currently on screen
     bool nav_pump;              // one-shot request to force a single read
     size_t max_bytes;
     size_t max_bytes_bw;
@@ -2372,10 +2373,12 @@ static bool read_packet(struct demux_internal *in)
         prefetch_more |= true;
     }
 
-    // While interactive disc navigation is active, never read ahead. It would
-    // advance the disc VM past what the user is watching. Reads still happen
-    // whenever a selected stream demands data.
-    if (in->nav_active)
+    // While a disc menu overlay is on screen, never read ahead. It would
+    // advance the disc VM (HDMV step / BD-J) past what the user is watching.
+    // During plain feature playback reads are unconstrained, so the cache
+    // follows demuxer-max-bytes as usual. Reads still happen whenever a
+    // selected stream demands data.
+    if (in->nav_menu_active)
         prefetch_more = false;
     prefetch_more |= in->nav_pump;
 
@@ -3304,6 +3307,20 @@ void demux_set_nav_active(demuxer_t *demuxer, bool active)
     mp_mutex_unlock(&in->lock);
 }
 
+// Tell the cache whether a disc menu overlay is currently on screen.
+void demux_set_nav_menu_active(demuxer_t *demuxer, bool active)
+{
+    struct demux_internal *in = demuxer->in;
+    mp_assert(demuxer == in->d_thread);
+
+    mp_mutex_lock(&in->lock);
+    if (in->nav_menu_active != active) {
+        in->nav_menu_active = active;
+        mp_cond_signal(&in->wakeup);
+    }
+    mp_mutex_unlock(&in->lock);
+}
